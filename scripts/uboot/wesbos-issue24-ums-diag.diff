 	struct blk_desc *block_dev = &ums_dev->block_dev;
 	lbaint_t blkstart = start + ums_dev->start_sector;
+	lbaint_t n = 0;
+	int tries;
 
-	return blk_dread(block_dev, blkstart, blkcnt, buf);
+	/*
+	 * PF1007L: the eMMC occasionally fails a read (the controller's CRC check
+	 * catches it). Retry instead of failing the SCSI command, which makes the
+	 * host drop the whole disk.
+	 */
+	for (tries = 1; tries <= 8; tries++) {
+		n = blk_dread(block_dev, blkstart, blkcnt, buf);
+		if (n == blkcnt)
+			break;
+		printf("UMS diag: read retry %d at sector " LBAF " (got " LBAF " of " LBAF ")\n",
+		       tries, blkstart, n, blkcnt);
+		writel(0x14af, (void *)0x01c20cb0);	/* feed the hardware watchdog */
+		mdelay(20);
+	}
+	return n;
 }
 
