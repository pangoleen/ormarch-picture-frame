diff --git a/arch/arm/dts/sun8i-a33-pf1007l-backup-u-boot.dtsi b/arch/arm/dts/sun8i-a33-pf1007l-backup-u-boot.dtsi
--- /dev/null
+++ b/arch/arm/dts/sun8i-a33-pf1007l-backup-u-boot.dtsi
@@ -0,0 +1,7 @@
+#include "sunxi-u-boot.dtsi"
+
+/* PF1007L: 8-bit high-speed eMMC reads fail on this board (PR #6, issue #16); use 4-bit at 26 MHz */
+&mmc2 {
+	bus-width = <4>;
+	max-frequency = <26000000>;
+};
