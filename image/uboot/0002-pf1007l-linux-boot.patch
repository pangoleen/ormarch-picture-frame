diff --git a/arch/arm/dts/sun8i-a33-pf1007l-linux.dts b/arch/arm/dts/sun8i-a33-pf1007l-linux.dts
new file mode 100644
index 0000000..0dd7c91
--- /dev/null
+++ b/arch/arm/dts/sun8i-a33-pf1007l-linux.dts
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * PF1007L build "L": U-Boot that boots Linux from the MicroSD card.
+ *
+ * Base: the backup build (Q8 A33 reference + USB peripheral mode, no VBUS
+ * drive). Changes for build L:
+ *  - eMMC (MMC2) disabled: this U-Boot has no device for the internal
+ *    storage. Android stays untouched (project safety rule 3).
+ *  - SDIO Wi-Fi (MMC1) disabled: U-Boot must not touch the Wi-Fi power pins.
+ *    On this unit PL2 = chip_en, PL6 = wl_reg_on (dumps/sys_config.fex).
+ *  - R_UART (PL2/PL3) disabled: PL2 is the Wi-Fi chip_en output on this unit.
+ *  - Console = UART0 with NO pins. The UART runs, the text goes nowhere.
+ *    No pad of the SoC is switched to a UART function.
+ *  - Display nodes disabled: the panel is MIPI-DSI, U-Boot cannot use it.
+ */
+
+#include "sun8i-a33-pf1007l-backup.dts"
+
+/ {
+	model = "PF1007L Linux boot (build L)";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart0 {
+	/* No pinctrl on purpose. See arch/arm/mach-sunxi/board.c,
+	 * CONFIG_SUNXI_CONSOLE_NO_PINMUX. */
+	status = "okay";
+};
+
+&r_uart {
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+	status = "disabled";
+};
+
+&mmc1 {
+	/delete-property/ mmc-pwrseq;
+	status = "disabled";
+};
+
+&mmc2 {
+	status = "disabled";
+};
+
+&de {
+	status = "disabled";
+};
+
+&tcon0 {
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+	status = "disabled";
+};
+
+&ehci0 {
+	status = "disabled";
+};
diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index b04ec67..c3e91ec 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -887,6 +887,22 @@ config SUNXI_MINIMUM_DRAM_MB
 	the default payload addresses must be shifted down.
 	This is expected to be fixed by the SoC selection.
 
+config SUNXI_CONSOLE_NO_PINMUX
+	bool "Do not set a pin mux for the console UART"
+	select SYS_CONSOLE_IS_IN_ENV
+	select SYS_DEVICE_NULLDEV
+	---help---
+	The SPL normally switches two pins to the console UART selected by
+	CONFIG_CONS_INDEX. With this option it leaves every pin as it is.
+	The UART still runs, but its output reaches no pin. Use this on a
+	board where each possible console pin has another function (PF1007L:
+	PL2 = Wi-Fi chip enable, PB0/PB1 = keys, PG6/PG7 = Bluetooth UART,
+	PF2/PF4 = SD card). The device tree must not give the console UART a
+	pinctrl property either.
+	With no pins there is no console input: the default environment sets
+	stdin=nulldev, so that nothing on a UART can stop autoboot, a script
+	or the ums command.
+
 config UART0_PORT_F
 	bool "UART0 on MicroSD breakout board"
 	---help---
