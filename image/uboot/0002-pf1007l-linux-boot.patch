diff --git a/configs/pf1007l_linux_defconfig b/configs/pf1007l_linux_defconfig
new file mode 100644
index 0000000..28c837e
--- /dev/null
+++ b/configs/pf1007l_linux_defconfig
@@ -0,0 +1,25 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="sun8i-a33-pf1007l-linux"
+CONFIG_SPL=y
+CONFIG_MACH_SUN8I_A33=y
+CONFIG_DRAM_CLK=456
+CONFIG_DRAM_ZQ=31739
+# CONFIG_VIDEO_SUNXI is not set
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_CONS_INDEX=1
+CONFIG_SUNXI_CONSOLE_NO_PINMUX=y
+CONFIG_AXP_DCDC1_VOLT=3300
+CONFIG_AXP_DCDC2_VOLT=1200
+CONFIG_AXP_ALDO1_VOLT=3300
+CONFIG_BOOTDELAY=-2
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="setenv stdin nulldev; if load mmc 0:1 ${scriptaddr} /boot.scr; then source ${scriptaddr}; fi; while true; do ums 0 mmc 0; sleep 3; done"
+CONFIG_SYS_CONSOLE_IS_IN_ENV=y
+CONFIG_SYS_DEVICE_NULLDEV=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_ENV_IS_IN_FAT is not set
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_CMD_USB_MASS_STORAGE=y
+CONFIG_CMD_UMS_NO_ABORT=y
+CONFIG_CRC32_VERIFY=y
diff --git a/configs/pf1007l_qemu_opipc_defconfig b/configs/pf1007l_qemu_opipc_defconfig
new file mode 100644
index 0000000..35ff667
--- /dev/null
+++ b/configs/pf1007l_qemu_opipc_defconfig
@@ -0,0 +1,28 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="sun8i-h3-orangepi-pc"
+CONFIG_SPL=y
+CONFIG_MACH_SUN8I_H3=y
+CONFIG_DRAM_CLK=624
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_SPL_I2C=y
+CONFIG_SPL_SYS_I2C_LEGACY=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_SY8106A_POWER=y
+# TEST ONLY: U-Boot for `qemu-system-arm -M orangepi-pc`. Same source, same
+# boot command and same script options as pf1007l_linux_defconfig, but the
+# Orange Pi PC board (Allwinner H3) and a visible serial console.
+# Same console input rule as build L (stdin=nulldev). QEMU does not model the pin mux,
+# so the serial output of this test build is still visible.
+CONFIG_SUNXI_CONSOLE_NO_PINMUX=y
+CONFIG_BOOTDELAY=-2
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="setenv stdin nulldev; if load mmc 0:1 ${scriptaddr} /boot.scr; then source ${scriptaddr}; fi; while true; do ums 0 mmc 0; sleep 3; done"
+CONFIG_SYS_CONSOLE_IS_IN_ENV=y
+CONFIG_SYS_DEVICE_NULLDEV=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_ENV_IS_IN_FAT is not set
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_CMD_USB_MASS_STORAGE=y
+CONFIG_CMD_UMS_NO_ABORT=y
+CONFIG_CRC32_VERIFY=y
diff --git a/drivers/usb/gadget/f_mass_storage.c b/drivers/usb/gadget/f_mass_storage.c
index d76ab97..9f7204c 100644
--- a/drivers/usb/gadget/f_mass_storage.c
+++ b/drivers/usb/gadget/f_mass_storage.c
@@ -664,13 +664,15 @@ static int sleep_thread(struct fsg_common *common)
 		}
 
 		if (k == 10) {
-			/* Handle START-STOP UNIT */
-			if (common->eject)
-				return -EPIPE;
-
-			/* Handle CTRL+C */
-			if (ctrlc())
-				return -EPIPE;
+			if (!IS_ENABLED(CONFIG_CMD_UMS_NO_ABORT)) {
+				/* Handle START-STOP UNIT */
+				if (common->eject)
+					return -EPIPE;
+
+				/* Handle CTRL+C */
+				if (ctrlc())
+					return -EPIPE;
+			}
 
 			/* Check cable connection */
 			if (!g_dnl_board_usb_cable_connected())
@@ -1323,6 +1325,10 @@ static int do_start_stop(struct fsg_common *common)
 		return -EINVAL;
 	}
 
+	/* The host's eject is accepted but does not end the ums command. */
+	if (IS_ENABLED(CONFIG_CMD_UMS_NO_ABORT))
+		return 0;
+
 	common->eject = 1;
 
 	return 0;
