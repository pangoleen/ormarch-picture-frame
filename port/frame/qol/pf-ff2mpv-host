#!/usr/bin/env python3
"""Native-messaging helper for the Firefox add-on "ff2mpv" (MIT, woodruffw/ff2mpv) on the PF1007L.

The add-on sends the page or link URL; this helper starts pf-youtube for YouTube links (480p H.264,
IPv4, full screen; E077) and plain mpv for anything else, then answers at once so Firefox does not
wait. Message format: 4-byte native-endian length + JSON {"url": ..., "options": [...]}.
"""
import json
import os
import struct
import subprocess
import sys


def read_message():
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        sys.exit(0)
    length = struct.unpack("@I", raw)[0]
    return json.loads(sys.stdin.buffer.read(length).decode("utf-8"))


def send(message):
    data = json.dumps(message, separators=(",", ":")).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(data)) + data)
    sys.stdout.buffer.flush()


url = read_message().get("url") or ""
youtube = any(host in url for host in ("youtube.com/", "youtu.be/"))
command = [os.path.expanduser("~/.local/bin/pf-youtube"), url] if youtube else ["mpv", "--fs", "--", url]
if url:
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
send({})
